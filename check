.toolbar{display:flex;gap:10px;align-items:center;margin:15px 0 12px;background:#061511;padding:8px;border-radius:10px}.toolbar input{flex:1;min-width:120px}.field{background:#03100d;border:1px solid #176653;color:white;padding:10px 12px;border-radius:8px;font-size:11px}.toolbar select{max-width:150px}
.games{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.game{background:linear-gradient(#082019,#03100e);border:1px solid #087e6a;border-radius:9px;overflow:hidden;min-width:0;transition:.2s}.game:hover{transform:translateY(-3px);box-shadow:0 0 14px #00ff6a33}.cover{height:115px;position:relative;background:#071a14}.cover img{width:100%;height:100%;object-fit:cover}.platform{position:absolute;right:5px;top:5px;background:var(--green);color:#00170b;padding:3px 5px;border-radius:4px;font-size:9px;font-weight:bold}.game-info{padding:8px}.game h3{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:7px}.meta{font-size:9px;color:#b5d7ca;display:flex;gap:5px;flex-wrap:wrap;margin-bottom:7px}.game .details{width:100%;padding:6px;border:1px solid var(--green);border-radius:15px;background:transparent;color:var(--green);font-size:10px;cursor:pointer}

