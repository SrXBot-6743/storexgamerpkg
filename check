.modal-box{width:min(500px,100%);max-height:90vh;overflow:auto;background:#061711;border:1px solid var(--green);border-radius:12px;padding:20px;box-shadow:0 0 25px #00ff6a33}.modal-box h2{color:var(--green);margin-bottom:14px}.formrow{margin:10px 0}.formrow label{display:block;font-size:11px;color:#b5d7ca;margin-bottom:5px}.formrow input,.formrow textarea,.formrow select{width:100%;background:#020b08;border:1px solid #236653;color:white;padding:10px;border-radius:7px}.actions{display:flex;justify-content:flex-end;gap:8px;margin-top:15px}.secondary{border:1px solid #6a8980;background:transparent;color:white;border-radius:8px;padding:9px 13px;cursor:pointer}
@media(max-width:1050px){.layout{grid-template-columns:1fr}.sidebar{display:none}.games{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:760px){.site{padding:0}.main{border-radius:0}header{height:auto;min-height:65px;padding:9px 12px;flex-wrap:wrap}.brand{min-width:0}.brand-name{font-size:15px}.brand-mark{width:39px;height:39px}nav{order:3;width:100%;overflow:auto;gap:17px}nav a{white-space:nowrap;padding:7px 0}.header-actions{margin-left:auto}.top-search{display:none}.hero{height:230px;padding:22px 18px;background-position:60% center}.hero h1{font-size:40px}.hero p{font-size:11px;letter-spacing:1px}.perks{gap:9px}.perk{padding-right:9px;font-size:9px}.perk strong{font-size:10px}.featured{margin:10px;padding:15px}.categories{grid-template-columns:repeat(3,1fr);gap:7px}.category{height:85px}.toolbar{flex-wrap:wrap}.toolbar input{flex-basis:100%}.toolbar select{flex:1;max-width:none}.games{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.cover{height:130px}.game h3{font-size:11px}footer{flex-wrap:wrap;justify-content:center;text-align:center}.social{order:3;width:100%;justify-content:center}}
</style>
