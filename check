        <div class="ps-subtitle">INICIANDO SESIÓN...</div>
        <div class="ps-field-group"><span class="ps-icon-left">👤</span><input id="email" class="ps-input" type="text" placeholder="Usuario / Correo"></div>
        <div class="ps-field-group"><span class="ps-icon-left">🔒</span><input id="pass" class="ps-input" type="password" placeholder="Contraseña"></div>
        <button class="ps-btn-submit" onclick="login()">ACCEDER →</button>
        <button class="ps-btn-back" onclick="closeModal('loginModal')">⟲ REGRESAR AL CATÁLOGO</button>
    </div>
</div>

<!-- MODAL AGREGAR/EDITAR JUEGO O APORTE -->
<div class="modal" id="gameModal"><div class="modal-box"><h2 id="gameModalTitle">Agregar Aporte</h2><input type="hidden" id="editId"><div class="formrow"><label>Nombre</label><input id="gTitle"></div><div class="formrow"><label>Tipo de Contenido</label><select id="gType"><option value="juego">Juego</option><option value="app">App</option><option value="herramienta">Herramienta</option></select></div><div class="formrow"><label>Plataforma</label><select id="gPlatform"><option>PC</option><option>PS4/PS5</option><option>Xbox</option><option>Android</option><option>iOS</option></select></div><div class="formrow"><label>Género / Categoría</label><input id="gGenre" placeholder="Acción, RPG, Utilidad..."></div><div class="formrow"><label>Descripción</label><textarea id="gDesc" rows="2"></textarea></div><div class="formrow"><label>Tamaño</label><input id="gSize" placeholder="Ej. 2.5 GB"></div><div class="formrow"><label>Portada (URL)</label><input id="gImg" placeholder="https://..."></div><div class="formrow"><label>Enlace de descarga autorizado</label><input id="gLink" placeholder="https://..."></div><div class="actions"><button class="secondary" onclick="closeModal('gameModal')">Cancelar</button><button class="primary" onclick="saveGame()">Publicar Aporte</button></div></div></div>

<!-- MODAL EDITAR CHAT XAT -->
<div class="modal" id="chatModal"><div class="modal-box"><h2>Configurar Xat.com</h2>
<p style="font-size:11px;color:var(--muted);margin-bottom:10px">Pega aquí tu código completo de iframe de xat.com o el enlace de tu sala.</p>
<div class="formrow"><textarea id="fChatCode" rows="4" style="width:100%" placeholder="<iframe src='https://xat.com/...'></iframe>"></textarea></div>
<div class="actions"><button class="secondary" onclick="closeModal('chatModal')">Cancelar</button><button class="primary" onclick="saveChat()">Guardar Chat</button></div></div></div>

<!-- MODAL EDITAR NOVEDADES -->
<div class="modal" id="sidebarModal"><div class="modal-box"><h2>Editar Panel de Novedades</h2><p style="font-size:11px;color:var(--muted);margin-bottom:10px">Formato: Ícono|Título|Texto (Uno por línea)</p><div class="formrow"><textarea id="fSidebarText" rows="6" style="width:100%"></textarea></div><div class="actions"><button class="secondary" onclick="closeModal('sidebarModal')">Cancelar</button><button class="primary" onclick="saveSidebar()">Guardar Novedades</button></div></div></div>

<!-- MODAL EDITAR REDES FOOTER -->
<div class="modal" id="socialModal"><div class="modal-box"><h2>Editar Redes de Footer</h2><p style="font-size:11px;color:var(--muted);margin-bottom:10px">Formato: Nombre|URL (Una red por línea)</p><div class="formrow"><textarea id="fSocialText" rows="5" style="width:100%"></textarea></div><div class="actions"><button class="secondary" onclick="closeModal('socialModal')">Cancelar</button><button class="primary" onclick="saveSocial()">Guardar Redes</button></div></div></div>

<!-- MODAL EDITAR SECCIONES Y REDES DE COMUNIDAD -->
<div class="modal" id="communityModal"><div class="modal-box"><h2>Editar Página de Comunidad</h2>
<p style="font-size:11px;color:var(--green);margin-bottom:5px"><b>1. Botones Rápidos de Redes:</b></p>
<div class="formrow"><textarea id="fCommunitySocialText" rows="4" style="width:100%"></textarea></div>
<p style="font-size:11px;color:var(--green);margin:12px 0 5px 0"><b>2. Tarjetas y Grupos:</b></p>
<div class="formrow"><textarea id="fCommunityCardsText" rows="5" style="width:100%"></textarea></div>
<div class="actions"><button class="secondary" onclick="closeModal('communityModal')">Cancelar</button><button class="primary" onclick="saveCommunitySections()">Guardar Comunidad</button></div></div></div>

<!-- MODAL FAQ -->
<div class="modal" id="faqModal"><div class="modal-box"><h2>ⓘ PREGUNTAS FRECUENTES (FAQ)</h2>
<div style="font-size:12px;line-height:1.6;color:#c4e5d9;display:grid;gap:12px;margin:15px 0;">
    <p><b style="color:var(--green)">1. ¿Cómo descargo los archivos PKG y juegos?</b><br>Haz clic en "Ver detalles" de cualquier juego y presiona el enlace directo de descarga.</p>
    <p><b style="color:var(--green)">2. ¿Cómo subir aportes como colaborador?</b><br>Inicia sesión con tus credenciales de colaborador autorizadas para publicar directamente tu contenido.</p>
</div>
<div class="actions"><button class="primary" onclick="closeModal('faqModal')">Entendido</button></div></div></div>

<script>
const defaults=[
{id:1,type:"juego",title:"God of War 3 Remastered",platform:"PS4/PS5",genre:"Acción",size:"39.5 GB",desc:"Épica aventura de acción y mitología.",img:"https://images.unsplash.com/photo-1542751371-adc38448a05e?w=600&q=80",link:"https://example.com"},
{id:2,type:"juego",title:"Final Fantasy XV",platform:"PS4/PS5",genre:"RPG",size:"110 GB",desc:"Aventura de rol en mundo abierto.",img:"https://images.unsplash.com/photo-1511512578047-dfb367046420?w=600&q=80",link:"https://example.com"},
{id:3,type:"juego",title:"NBA 2K20",platform:"PS4/PS5",genre:"Deportes",size:"45 GB",desc:"Simulador de básquetbol profesional.",img:"https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=600&q=80",link:"https://example.com"},
{id:4,type:"juego",title:"Mafia 2 Definitive Edition",platform:"PS4/PS5",genre:"Acción",size:"38 GB",desc:"Historia de crimen y mafia organizada.",img:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=600&q=80",link:"https://example.com"},
{id:5,type:"app",title:"Devil May Cry Special Edition",platform:"Android",genre:"Acción",size:"3.2 GB",desc:"Edición especial de acción rápida.",img:"https://images.unsplash.com/photo-1593305841991-05c297ba4575?w=600&q=80",link:"https://example.com"}
];

let games = JSON.parse(localStorage.getItem("sxg_games")||"null");
if(!games || games.length === 0){
    games = defaults;
    localStorage.setItem("sxg_games", JSON.stringify(games));
} else {
    games = games.map(g => {
        if([1,2,3,4].includes(g.id)) g.type = "juego";
        return g;
    });
    localStorage.setItem("sxg_games", JSON.stringify(games));
}

let userRole = localStorage.getItem("sxg_role") || "guest";
let activeFilter = "all";
let randomFeaturedGame = null;

let sidebarData = JSON.parse(localStorage.getItem("sxg_sidebar")||"null") || [
    {ico:"🔥", title:"¡Nuevo Estreno!", text:"Ya disponible la nueva actualización de juegos en la plataforma."},
    {ico:"⚡", title:"Descargas Seguras", text:"Servidores optimizados para máxima velocidad sin anuncios molestos."},
    {ico:"💬", title:"Comunidad Activa", text:"Únete a nuestros canales oficiales para pedir juegos y reportar enlaces caídos."}
];

let socialData = JSON.parse(localStorage.getItem("sxg_social")||"null") || [
    {name:"Discord", url:"https://discord.com"}, {name:"WhatsApp", url:"https://whatsapp.com"}, {name:"Telegram", url:"https://telegram.org"}, {name:"YouTube", url:"https://youtube.com"}, {name:"TikTok", url:"https://tiktok.com"}
];

let communitySocialData = JSON.parse(localStorage.getItem("sxg_community_social")||"null") || [
    {name:"💬 Telegram", url:"https://telegram.org"},
    {name:"📸 Instagram", url:"https://instagram.com"},
    {name:"🎮 Discord", url:"https://discord.com"},
    {name:"🎥 YouTube", url:"https://youtube.com"},
    {name:"🎵 TikTok", url:"https://tiktok.com"}
];

let communitySectionsData = JSON.parse(localStorage.getItem("sxg_community_sections")||"null") || [
    {title:"💬 Grupo Principal de Discord", desc:"Conéctate con miles de gamers, chatea y encuentra compañeros de partida.", btn:"Unirme a Discord", url:"https://discord.com"},
    {title:"📢 Canal Oficial de WhatsApp", desc:"Entérate al instante de los nuevos aportes y estrenos subidos a la tienda.", btn:"Seguir Canal", url:"https://whatsapp.com"},
    {title:"🛠 Soporte y Reportes", desc:"¿Encontraste un enlace caído o necesitas ayuda? Repórtalo aquí con el staff.", btn:"Reportar Problema", url:"https://example.com"}
];

let xatCustomCode = localStorage.getItem("sxg_xat_code") || '<iframe src="https://xat.com/embed/room.php?id=StoreXGamerPKG" scrolling="no"></iframe>';

const $=id=>document.getElementById(id);
function safe(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}

function navAction(target){
    const links = document.querySelectorAll("#topNav a");
    links.forEach(l => l.classList.remove("active"));
    
    $("shopView").classList.remove("active");
    $("chatView").classList.remove("active");
    $("communityView").classList.remove("active");

    if(target === 'inicio'){
        links[0].classList.add("active");
        activeFilter = "all";
        $("search").value = "";
        $("shopView").classList.add("active");
        $("sectionListTitle").textContent = "🔥 CATÁLOGO";
        window.scrollTo({top:0, behavior:'smooth'});
    } else if(target === 'juegos'){
        links[1].classList.add("active");
        activeFilter = "juego";
        $("search").value = "";
        $("shopView").classList.add("active");
        $("sectionListTitle").textContent = "🎮 CATÁLOGO DE JUEGOS";
        document.getElementById("juegos").scrollIntoView({behavior:'smooth'});
    } else if(target === 'apps'){
        links[2].classList.add("active");
        activeFilter = "app";
        $("search").value = "";
        $("shopView").classList.add("active");
        $("sectionListTitle").textContent = "▣ CATÁLOGO DE APLICACIONES";
        document.getElementById("juegos").scrollIntoView({behavior:'smooth'});
    } else if(target === 'herramientas'){
        links[3].classList.add("active");
        activeFilter = "herramienta";
        $("search").value = "";
        $("shopView").classList.add("active");
        $("sectionListTitle").textContent = "⚒ CATÁLOGO DE HERRAMIENTAS";
        document.getElementById("juegos").scrollIntoView({behavior:'smooth'});
    } else if(target === 'chat'){
        links[4].classList.add("active");
        $("chatView").classList.add("active");
        renderChat();
        window.scrollTo({top:0, behavior:'smooth'});
    } else if(target === 'comunidad'){
        links[5].classList.add("active");
        $("communityView").classList.add("active");
        window.scrollTo({top:0, behavior:'smooth'});
    } else if(target === 'faq'){
        links[6].classList.add("active");
        $("faqModal").classList.add("show");
    }
    render();
}

function checkAdminState(){
    if(userRole === "guest"){
        $("adminBanner").classList.remove("active");
        $("addBtn").style.display = "none";
        $("loginBtn").style.display = "inline-block";
        $("editSidebarBtn").style.display = "none";
        $("editSocialBtn").style.display = "none";
        $("editCommunityBtn").style.display = "none";
        $("editChatBtn").style.display = "none";
        return;
    }

    let isInicio = (activeFilter === "all" && $("search").value === "" && document.getElementById("shopView").classList.contains("active") && window.scrollY < 200);

    if(userRole === "admin" && !isInicio){
        $("adminBanner").classList.add("active");
        $("adminBannerText").textContent = "⚙ MODO ADMINISTRADOR ACTIVO — Control total de la tienda.";
        $("addBtn").style.display = "inline-block";
        $("loginBtn").style.display = "none";
        $("editSidebarBtn").style.display = "block";
        $("editSocialBtn").style.display = "block";
        $("editCommunityBtn").style.display = "block";
        $("editChatBtn").style.display = "block";
    } else if(userRole === "colab" && !isInicio){
        $("adminBanner").classList.add("active");
        $("adminBannerText").textContent = "✍ MODO COLABORADOR ACTIVO — Puedes subir aportes al catálogo.";
        $("addBtn").style.display = "inline-block";
        $("loginBtn").style.display = "none";
        $("editSidebarBtn").style.display = "none";
        $("editSocialBtn").style.display = "none";
        $("editCommunityBtn").style.display = "none";
        $("editChatBtn").style.display = "none";
    } else {
        $("adminBanner").classList.remove("active");
        $("addBtn").style.display = "none";
        $("loginBtn").style.display = "inline-block";
        $("editSidebarBtn").style.display = "none";
        $("editSocialBtn").style.display = "none";
        $("editCommunityBtn").style.display = "none";
        $("editChatBtn").style.display = "none";
    }
}

function renderFeatured(){
    if(games && games.length > 0){
        let itemsDisponibles = games.filter(g => g.type === "juego");
        if(itemsDisponibles.length === 0) itemsDisponibles = games;
        let randomIndex = Math.floor(Math.random() * itemsDisponibles.length);
        randomFeaturedGame = itemsDisponibles[randomIndex];

        $("featTag").textContent = "★ DESTACADO ALEATORIO: " + (randomFeaturedGame.genre || "JUEGO");
        $("featTitle").textContent = randomFeaturedGame.title;
        $("featDesc").textContent = randomFeaturedGame.desc || "Explora este increíble título disponible en nuestra tienda.";
        $("featuredSection").style.backgroundImage = `url('${randomFeaturedGame.img}')`;
        $("featPills").innerHTML = `
            <span class="pill">${safe(randomFeaturedGame.platform)}</span>
            <span class="pill">${safe(randomFeaturedGame.genre)}</span>
            <span class="pill">${safe(randomFeaturedGame.size)}</span>
        `;
    }
}

function featuredDownload(){
    if(randomFeaturedGame){
        details(randomFeaturedGame.id);
    } else {
        navAction('juegos');
    }
}

function renderSidebar(){
    $("sidebarContentList").innerHTML = sidebarData.map(item=>`
        <li>
            <span class="ico">${item.ico||"📌"}</span>
            <span><b>${safe(item.title)}</b>${safe(item.text)}</span>
        </li>
    `).join("");
}

function renderSocial(){
    $("socialList").innerHTML = socialData.map(s => `
        <a href="${safe(s.url)}" target="_blank" rel="noopener">◉ ${safe(s.name)}</a>
    `).join("");
}

function renderCommunity(){
    $("communitySocialBar").innerHTML = communitySocialData.map(cs => `
        <a href="${safe(cs.url)}" target="_blank" rel="noopener" class="community-social-btn">${safe(cs.name)}</a>
    `).join("");

    $("communityGridContainer").innerHTML = communitySectionsData.map(sec => `
        <div class="community-card">
            <h3>${safe(sec.title)}</h3>
            <p>${safe(sec.desc)}</p>
            <a href="${safe(sec.url)}" target="_blank" rel="noopener" class="community-btn">${safe(sec.btn)} →</a>
        </div>
    `).join("");
}

function renderChat(){
    $("xatWrapper").innerHTML = xatCustomCode;
}

function render(){
    checkAdminState();
    renderFeatured();
    renderSidebar();
    renderSocial();
    renderCommunity();

    let q=$("search").value.toLowerCase(),p=$("platform").value,sort=$("sort").value;
    
    let list = games.filter(g => {
        let matchesType = (activeFilter === "all") || (String(g.type).toLowerCase() === activeFilter.toLowerCase());
        let matchesPlatform = (!p || g.platform === p);
        let matchesQuery = [g.title, g.genre, g.platform, g.desc].join(" ").toLowerCase().includes(q);
        return matchesType && matchesPlatform && matchesQuery;
    });

    if(sort==="az")list.sort((a,b)=>a.title.localeCompare(b.title));
    else list.sort((a,b)=>b.id-a.id);

    $("games").innerHTML=list.map(g=>`
        <article class="game">
            <div class="cover">
                <img src="${safe(g.img)}" alt="${safe(g.title)}" onerror="this.style.opacity='.2'">
                <span class="platform">${safe(g.platform)}</span>
            </div>
            <div class="game-info">
                <h3>${safe(g.title)}</h3>
                <div class="meta">
                    <span>🎮 ${safe(g.genre)}</span>
                    <span>💾 ${safe(g.size)}</span>
                </div>
                <button class="details" onclick="details(${g.id})">Ver detalles →</button>
                ${userRole === "admin"?`
                <div style="display:flex;gap:5px;margin-top:7px">
                    <button class="secondary" style="flex:1;background:#062018;color:var(--green);border-color:var(--green);" onclick="editGame(${g.id})">✏ Editar</button>
                    <button class="secondary" style="flex:1;background:#200606;color:#ff4d4d;border-color:#ff4d4d;" onclick="deleteGame(${g.id})">🗑 Borrar</button>
                </div>`:""}
            </div>
        </article>
    `).join("")||'<p style="color:#9ab9ae;grid-column:1/-1;">No hay ítems en esta categoría.</p>';
}

function details(id){let g=games.find(x=>x.id===id);if(!g)return;alert(`${g.title}\n${g.platform} · ${g.genre}\n${g.desc}\nTamaño: ${g.size}`);if(g.link&&g.link!=="https://example.com"&&g.link!=="#")window.open(g.link,"_blank","noopener")}
function openLogin(){$("loginModal").classList.add("show")}
function closeModal(id){$(id).classList.remove("show")}

function login(){
    let e = $("email").value.trim().toLowerCase();
    let p = $("pass").value.trim();
    
    if(!e && !p){ e = "admin@storexgamerpkg.com"; p = "Xg@m3r_Pkg#987!Secure"; }

    if(e === "admin@storexgamerpkg.com" && p === "Xg@m3r_Pkg#987!Secure"){
        userRole = "admin";
        localStorage.setItem("sxg_role", "admin");
        closeModal("loginModal");
        render();
        alert("¡Modo Administrador activado!");
    } else if(e === "colab@storexgamerpkg.com" && p === "colab123"){
        userRole = "colab";
        localStorage.setItem("sxg_role", "colab");
        closeModal("loginModal");
        render();
        alert("¡Modo Colaborador activado! Puedes agregar nuevos aportes.");
    } else { 
        alert("Credenciales incorrectas."); 
    }
}

function logout(){
    userRole = "guest";
    localStorage.removeItem("sxg_role");
    navAction('inicio');
    render();
    alert("Sesión cerrada correctamente.");
}

function openGame(id=null){$("gameModalTitle").textContent=id?"Editar ítem":"Agregar Aporte";let g=games.find(x=>x.id===id)||{};$("editId").value=g.id||"";$("gTitle").value=g.title||"";$("gType").value=g.type||"juego";$("gPlatform").value=g.platform||"PC";$("gGenre").value=g.genre||"";$("gDesc").value=g.desc||"";$("gSize").value=g.size||"";$("gImg").value=g.img||"";$("gLink").value=g.link||"";$("gameModal").classList.add("show")}
function editGame(id){if(userRole==='admin') openGame(id)}
function saveGame(){let title=$("gTitle").value.trim();if(!title){alert("Escribe el nombre del ítem.");return}let id=Number($("editId").value),obj={id:id||Date.now(),title,type:$("gType").value,platform:$("gPlatform").value,genre:$("gGenre").value.trim(),desc:$("gDesc").value.trim(),size:$("gSize").value.trim(),img:$("gImg").value.trim(),link:$("gLink").value.trim()||"https://example.com"};if(id && userRole==='admin')games=games.map(g=>g.id===id?obj:g);else games.unshift(obj);localStorage.setItem("sxg_games",JSON.stringify(games));closeModal("gameModal");render()}
function deleteGame(id){if(userRole==='admin' && confirm("¿Eliminar este ítem del catálogo?")){games=games.filter(g=>g.id!==id);localStorage.setItem("sxg_games",JSON.stringify(games));render()}}

function openSidebarModal(){
    if(userRole!=='admin')return;
    $("fSidebarText").value = sidebarData.map(i => `${i.ico}|${i.title}|${i.text}`).join("\n");
    $("sidebarModal").classList.add("show");
}

function saveSidebar(){
    let lines = $("fSidebarText").value.split("\n").filter(Boolean);
    sidebarData = lines.map(line => {
        let parts = line.split("|");
        if(parts.length >= 3){
            return { ico: parts[0].trim(), title: parts[1].trim(), text: parts[2].trim() };
        }
        return { ico: "📌", title: "Aviso", text: line.trim() };
    });
    localStorage.setItem("sxg_sidebar", JSON.stringify(sidebarData));
    closeModal("sidebarModal");
    renderSidebar();
    alert("¡Panel de novedades actualizado!");
}

function openSocialModal(){
    if(userRole!=='admin')return;
    $("fSocialText").value = socialData.map(s => `${s.name}|${s.url}`).join("\n");
    $("socialModal").classList.add("show");
}

function saveSocial(){
    let lines = $("fSocialText").value.split("\n").filter(Boolean);
    socialData = lines.map(line => {
        let parts = line.split("|");
        return { name: parts[0].trim(), url: parts[1] ? parts[1].trim() : "https://example.com" };
    });
    localStorage.setItem("sxg_social", JSON.stringify(socialData));
    closeModal("socialModal");
    renderSocial();
    alert("¡Redes de footer actualizadas!");
}

function openCommunityModal(){
    if(userRole!=='admin')return;
    $("fCommunitySocialText").value = communitySocialData.map(cs => `${cs.name}|${cs.url}`).join("\n");
    $("fCommunityCardsText").value = communitySectionsData.map(c => `${c.title}|${c.desc}|${c.btn}|${c.url}`).join("\n");
    $("communityModal").classList.add("show");
}

function saveCommunitySections(){
    let socialLines = $("fCommunitySocialText").value.split("\n").filter(Boolean);
    communitySocialData = socialLines.map(line => {
        let parts = line.split("|");
        return { name: parts[0] ? parts[0].trim() : "Red", url: parts[1] ? parts[1].trim() : "https://example.com" };
    });

    let cardLines = $("fCommunityCardsText").value.split("\n").filter(Boolean);
    communitySectionsData = cardLines.map(line => {
        let parts = line.split("|");
        return {
            title: parts[0] ? parts[0].trim() : "Grupo",
            desc: parts[1] ? parts[1].trim() : "Descripción...",
            btn: parts[2] ? parts[2].trim() : "Acceder",
            url: parts[3] ? parts[3].trim() : "https://example.com"
        };
    });

    localStorage.setItem("sxg_community_social", JSON.stringify(communitySocialData));
    localStorage.setItem("sxg_community_sections", JSON.stringify(communitySectionsData));
    closeModal("communityModal");
    renderCommunity();
    alert("¡Página de comunidad actualizada con éxito!");
}

function openChatModal(){
    if(userRole!=='admin')return;
    $("fChatCode").value = xatCustomCode;
    $("chatModal").classList.add("show");
}

function saveChat(){
    let code = $("fChatCode").value.trim();
    if(code){
        xatCustomCode = code;
        localStorage.setItem("sxg_xat_code", xatCustomCode);
        closeModal("chatModal");
        renderChat();
        alert("¡Chat actualizado con éxito!");
    } else {
        alert("Ingresa un código de xat válido.");
    }
}

$("search").addEventListener("input",render);$("platform").addEventListener("change",render);$("sort").addEventListener("change",render);$("topSearch").addEventListener("input",e=>{$("search").value=e.target.value;render();location.hash="#juegos"});document.querySelectorAll(".category").forEach(c=>c.addEventListener("click",()=>{$("search").value=c.dataset.filter;render();location.hash="#juegos"}));render();
</script>
</body>
</html>
